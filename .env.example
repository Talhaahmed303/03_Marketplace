# ==============================================================================
# FALCONXOFT WEEKEND 1 EVALUATION — PROJECT 03: TWO-SIDED MARKETPLACE
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your local environment.
# DO NOT commit real secrets or credentials to source control.

# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-marketplace-eval-secret-key-change-in-production-2026-xyz
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Port Allocation
BACKEND_PORT=8003
FRONTEND_PORT=3003

# PostgreSQL Database Configuration
DB_NAME=marketplace_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Configuration (Next.js Marketplace UI)
CORS_ALLOWED_ORIGINS=http://localhost:3003,http://127.0.0.1:3003

# Next.js Frontend Environment Variable
NEXT_PUBLIC_API_URL=http://127.0.0.1:8003/api
